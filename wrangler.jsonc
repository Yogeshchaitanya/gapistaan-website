{
  // Cloudflare Workers: साइट dist/ फ़ोल्डर से चलती है। src/worker.js सिर्फ़ पेजों पर चलकर
  // बाकी domains (gapistaan.in, gapistan.in, www) को gapistaan.com पर भेजता है।
  "name": "gapistaan-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/", "/video/*"]
  }
}
