{
  // PICHCHRAPA: site served from pichchrapa/dist. src/worker.js runs for the pages listed below
  // (sends www or any other host to https://pichchrapa.com and adds the security headers).
  "name": "pichchrapa-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/", "/en", "/en/*", "/video/*", "/filmy-adalat/*", "/raja-ka-baja/*", "/about/*", "/contact/*", "/privacy/*"]
  }
}
