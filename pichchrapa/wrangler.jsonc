{
  // PICHCHRAPA: site served from pichchrapa/dist. src/worker.js runs for the pages listed below
  // (sends www or any other host to https://pichchrapa.com and adds the security headers) and answers /api/*
  // (the "Honour the artists" payments through Razorpay; secrets RZP_KEY_ID and RZP_KEY_SECRET, see src/worker.js).
  "name": "pichchrapa-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/", "/en", "/en/*", "/video/*", "/filmy-adalat/*", "/raja-ka-baja/*", "/about/*", "/contact/*", "/privacy/*", "/support/*", "/terms/*", "/refund-policy/*", "/shipping-policy/*", "/pricing/*", "/api/*"]
  },
  // Owner alerts by email through Cloudflare Email Routing (no mailbox password).
  "send_email": [{ "name": "MAILER", "destination_address": "yogeshcineact@gmail.com" }],
  "vars": { "MAIL_FROM": "contact@pichchrapa.com", "NOTIFY_TO": "yogeshcineact@gmail.com" }
}
